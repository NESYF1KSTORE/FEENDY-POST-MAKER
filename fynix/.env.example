# Copy to .env on the server and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# --- deployment identity ---
FYNIX_ENV=prod
# The public domain Caddy will obtain a certificate for.
# For a first run without DNS, set FYNIX_DOMAIN=:80 and FYNIX_BASE_URL=http://<server-ip>
FYNIX_DOMAIN=fynix.example.com
FYNIX_BASE_URL=https://fynix.example.com
FYNIX_LOG_LEVEL=INFO

# --- secrets (required) ---
POSTGRES_PASSWORD=
JWT_SECRET=

# --- first admin, created by `make bootstrap` ---
BOOTSTRAP_ADMIN_EMAIL=admin@fynix.example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- AI providers ---
# `mock` runs the whole pipeline offline with no spend — the safe default for a
# first deploy. Switch to `anthropic` or `deepseek` once the keys are in place.
AI_DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- runners ---
# `local` runs agent work in a throwaway directory inside the container.
# `docker` gives each run its own network-less, read-only, non-root container
# and requires mounting the Docker socket into the worker — read DEPLOY.md first.
RUNNER_DRIVER=local

# --- notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- budgets ---
DEFAULT_PROJECT_BUDGET_RUB=50000
